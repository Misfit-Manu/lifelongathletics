.7}.tk-wrap .callout b{color:#e8e2d8;font-weight:600}.tk-wrap .callout.warn{border-left-color:#C0392B}.tk-wrap .callout.good{border-left-color:#4A9E5C}.tk-wrap .fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:11px;padding:10px 36px 4px}.tk-wrap .fcard{background:#161412;border:1px solid #242220;border-radius:7px;padding:14px 16px}.tk-wrap .fcard h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#b4aea6;margin-bottom:8px}.tk-wrap .fcard code{display:block;font-family:'SF Mono',Consolas,monospace;font-size:12.5px;color:#7FD8C4;background:#0e0d0c;padding:9px 11px;border-radius:5px;margin-bottom:7px;line-height:1.6}.tk-wrap .fcard p{font-size:12px;color:#a19b92;line-height:1.6}.tk-wrap .footer{padding:40px 36px 0;font-size:11.5px;color:#9a958c;line-height:1.95;border-top:1px solid #2a2724;margin-top:50px}.tk-wrap .footer b{color:#c2bdb4}@media print{.tk-wrap .nav{position:static}}.tk-wrap .bn-anthro{background:linear-gradient(90deg,#0D4A38 0%,#14785A 100%)}.tk-wrap .bn-screen{background:linear-gradient(90deg,#7A1418 0%,#B02830 100%)}.tk-wrap .bn-prog{background:linear-gradient(90deg,#2E2470 0%,#4838B0 100%)}.tk-wrap .calc{margin:14px 36px;background:#141311;border:1px solid #2a2724;border-radius:9px;overflow:hidden}.tk-wrap .calc-head{background:#1c1a17;padding:12px 18px;border-bottom:1px solid #2a2724;display:flex;align-items:center;gap:10px}.tk-wrap .calc-head h4{font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#d8d2c8}.tk-wrap .calc-head .tagx{font-size:10.5px;color:#959088;margin-left:auto}.tk-wrap .calc-body{padding:16px 18px}.tk-wrap .crow{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px}.tk-wrap .cfield{flex:1;min-width:112px}.tk-wrap .cfield label{display:block;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:#a8a29a;margin-bottom:4px}.tk-wrap .cfield input,.tk-wrap .cfield select{width:100%;background:#0d0c0b;border:1px solid #2e2b28;border-radius:5px;color:#f0ece4;
  padding:8px 10px;font-size:13.5px;font-family:inherit;outline:none;transition:.15s}.tk-wrap .cfield input:focus,.tk-wrap .cfield select:focus{border-color:#5a9e7a;background:#0f0e0d}.tk-wrap .cfield input::placeholder{color:#6a655e}.tk-wrap .cfield .hint{font-size:10px;color:#8f8a82;margin-top:3px;line-height:1.35}.tk-wrap .cout{margin-top:6px;background:#0d0c0b;border:1px solid #262320;border-radius:7px;padding:14px 16px;min-height:56px}.tk-wrap .cout .placeholder{font-size:12.5px;color:#8f8a82;font-style:italic}.tk-wrap .cres{display:flex;flex-wrap:wrap;gap:20px 30px}.tk-wrap .cres .item{min-width:96px}.tk-wrap .cres .lbl{font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:#a8a29a;margin-bottom:3px}.tk-wrap .cres .val{font-size:21px;font-weight:700;color:#7FD8C4;font-variant-numeric:tabular-nums;line-height:1.15}.tk-wrap .cres .val.sm{font-size:15px}.tk-wrap .cres .sub{font-size:11px;color:#9a958c;margin-top:2px}.tk-wrap .cnote{margin-top:11px;padding-top:10px;border-top:1px solid #2a2724;font-size:12px;color:#a8a29a;line-height:1.6}.tk-wrap .cerr{color:#E07868;font-size:12px}.tk-wrap .badge{display:inline-block;font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;padding:2px 8px;border-radius:3px;margin-left:6px}.tk-wrap .bg-ok{background:#0E2A14;color:#6ECF80}.tk-wrap .bg-mid{background:#2E2607;color:#E0C040}.tk-wrap .bg-hi{background:#331A08;color:#F09048}.tk-wrap .bg-vhi{background:#330E0A;color:#F07060}.tk-wrap .bg-lo{background:#0E2436;color:#6BA8D8}.tk-wrap td.good{color:#7EDD90;font-size:12px}.tk-wrap td.bad{color:#F08878;font-size:12px}.tk-wrap td.warn2{color:#EBCE55;font-size:12px}.tk-wrap td.dim{color:#a19b92;font-size:12px}
