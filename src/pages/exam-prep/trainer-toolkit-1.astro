---
import Layout from '../../layouts/Layout.astro';
import body from '../../toolkit-content/toolkit-1-body.html?raw';
---

<Layout title="Trainer Toolkit I — Intensity, Food & Rate of Change | Lifelong Athletics" description="Cardio and strength intensity across every scale, 77 Indian foods decoded to macros, and realistic fat-loss and muscle-gain timelines.">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css" />

<div class="tk-backbar"><a href="/exam-prep" class="tk-back">← Back to Study Hub</a></div>

<div class="tk-wrap" set:html={body}></div>

<style is:global>
.tk-wrap *{margin:0;padding:0;box-sizing:border-box}.tk-wrap{background:#111110;color:#e0dbd3;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}.tk-wrap .page{max-width:1180px;margin:0 auto;padding-bottom:80px}.tk-wrap .masthead{padding:40px 36px 28px;border-bottom:1px solid #1e1c1a;background:linear-gradient(180deg,#16150f 0%,#111110 100%)}.tk-wrap .masthead h1{font-size:30px;font-weight:700;letter-spacing:-.6px;color:#f5f1e8}.tk-wrap .masthead .sub{font-size:13px;color:#a8a29a;margin-top:7px}.tk-wrap .masthead .meta{font-size:11px;color:#8a867e;margin-top:14px;letter-spacing:.03em}.tk-wrap .nav{display:flex;flex-wrap:wrap;gap:7px;padding:16px 36px;background:#0d0c0b;border-bottom:1px solid #1e1c1a;position:sticky;top:0;z-index:50}.tk-wrap .nav a{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;padding:6px 13px;border-radius:5px;text-decoration:none;background:#1a1816;color:#a8a29a;border:1px solid #262422;transition:.15s}.tk-wrap .nav a:hover{background:#242220;color:#e0dbd3}.tk-wrap .section-banner{display:flex;align-items:center;gap:12px;padding:17px 36px;font-size:17px;font-weight:600;letter-spacing:-.2px;color:#fff;margin-top:40px}.tk-wrap .section-banner .n{font-size:11px;font-weight:700;opacity:.55;letter-spacing:.14em}.tk-wrap .section-banner i{font-size:19px;opacity:.9}.tk-wrap .bn-cardio{background:linear-gradient(90deg,#0C4A52 0%,#12717D 100%)}.tk-wrap .bn-strength{background:linear-gradient(90deg,#7A4408 0%,#B8700F 100%)}.tk-wrap .bn-nutri{background:linear-gradient(90deg,#14501E 0%,#1F7A2E 100%)}.tk-wrap .bn-rate{background:linear-gradient(90deg,#43146B 0%,#6B2199 100%)}.tk-wrap .intro{padding:15px 36px 6px;font-size:13px;color:#a8a29a;line-height:1.7;max-width:900px}.tk-wrap .intro b{color:#c8c2b8;font-weight:600}.tk-wrap .subhead{padding:26px 36px 9px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.13em;color:#a8a29a;display:flex;align-items:center;gap:11px}.tk-wrap .subhead::after{content:'';flex:1;height:1px;background:#242220}.tk-wrap .twrap{padding:4px 36px 14px;overflow-x:auto;overflow-y:hidden}.tk-wrap table{border-radius:6px;overflow:hidden}.tk-wrap table{width:100%;border-collapse:collapse;font-size:12.5px;min-width:640px}.tk-wrap thead th{background:#1f1d1a;color:#b4aea6;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;padding:11px 9px 10px;text-align:left;border-bottom:2px solid #3a3733;white-space:nowrap;vertical-align:bottom}.tk-wrap tbody tr:first-child td{padding-top:12px}.tk-wrap tbody td{padding:10px 9px;border-bottom:1px solid #1c1a18;vertical-align:top;color:#cdc8bf}.tk-wrap tbody tr:hover{background:#171512}.tk-wrap tbody td.k{font-weight:600;color:#f0ece4;white-space:nowrap}.tk-wrap tbody td.num{font-variant-numeric:tabular-nums;white-space:nowrap}.tk-wrap tbody td.dim{color:#a19b92;font-size:12px}.tk-wrap tbody td.say{color:#9fd09f;font-size:12px;font-style:italic}.tk-wrap .grp-row td{background:#1b1917;color:#c2bdb4;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;padding:8px 9px;border-bottom:1px solid #262422}.tk-wrap .b1{border-left:3px solid #3E7CB1}.tk-wrap .b2{border-left:3px solid #4A9E5C}.tk-wrap .b3{border-left:3px solid #C9A227}.tk-wrap .b4{border-left:3px solid #D2691E}.tk-wrap .b5{border-left:3px solid #C0392B}.tk-wrap .pill{display:inline-block;font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:2px 7px;border-radius:3px;white-space:nowrap}.tk-wrap .p1{background:#0E2436;color:#6BA8D8}.tk-wrap .p2{background:#0E2A14;color:#6ECF80}.tk-wrap .p3{background:#2E2607;color:#E0C040}.tk-wrap .p4{background:#331A08;color:#F09048}.tk-wrap .p5{background:#330E0A;color:#F07060}.tk-wrap .callout{margin:14px 36px;padding:15px 18px;border-radius:7px;background:#141311;border:1px solid #2a2724;border-left:3px solid #C9A227;font-size:13px;color:#b0aaa1;line-height:1.7}.tk-wrap .callout b{color:#e8e2d8;font-weight:600}.tk-wrap .callout.warn{border-left-color:#C0392B}.tk-wrap .callout.good{border-left-color:#4A9E5C}.tk-wrap .fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:11px;padding:10px 36px 4px}.tk-wrap .fcard{background:#161412;border:1px solid #242220;border-radius:7px;padding:14px 16px}.tk-wrap .fcard h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#b4aea6;margin-bottom:8px}.tk-wrap .fcard code{display:block;font-family:'SF Mono',Consolas,monospace;font-size:12.5px;color:#7FD8C4;background:#0e0d0c;padding:9px 11px;border-radius:5px;margin-bottom:7px;line-height:1.6}.tk-wrap .fcard p{font-size:12px;color:#a19b92;line-height:1.6}.tk-wrap .footer{padding:40px 36px 0;font-size:11.5px;color:#9a958c;line-height:1.95;border-top:1px solid #2a2724;margin-top:50px}.tk-wrap .footer b{color:#c2bdb4}@media print{.tk-wrap .nav{position:static}}
.tk-wrap .nav{position:static}
.tk-backbar{max-width:1180px;margin:0 auto;padding:92px 36px 0;background:#111110}
.tk-back{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:#a8a29a;text-decoration:none}
.tk-back:hover{color:#e0dbd3}
</style>



</Layout>
