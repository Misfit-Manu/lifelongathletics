---
import Layout from '../../layouts/Layout.astro';
import body from '../../toolkit-content/beginner-exercise-body.html?raw';
---

<Layout title="Beginner's Exercise Toolkit — Explained Simply | Lifelong Athletics" description="The plain-English answers to every beginner question — where to start, how hard, sets, reps and rest, how to progress, calorie burn, and when results show. Four calculators, no jargon.">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css" />

<div class="tk-backbar"><a href="/blog" class="tk-back">← Back to Education</a></div>

<div class="tk-wrap" set:html={body}></div>

<style is:global>
