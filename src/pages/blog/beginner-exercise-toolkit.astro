  background:#1e1c1a;color:#b4aea4;border:1px solid #2c2926;transition:.15s}.tk-wrap .nav a:hover{background:#2a2724;color:#f0ece4}.tk-wrap .q-banner{padding:22px 32px;margin-top:44px;color:#fff}.tk-wrap .q-banner .n{font-size:12px;font-weight:700;letter-spacing:.16em;opacity:.65;display:block;margin-bottom:5px}.tk-wrap .q-banner h2{font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:1.25}.tk-wrap .qb1{background:linear-gradient(100deg,#0C4A52,#12717D)}.tk-wrap .qb2{background:linear-gradient(100deg,#7A4408,#B8700F)}.tk-wrap .qb3{background:linear-gradient(100deg,#14501E,#1F7A2E)}.tk-wrap .qb4{background:linear-gradient(100deg,#43146B,#6B2199)}.tk-wrap .qb5{background:linear-gradient(100deg,#0A3A6B,#1560A8)}.tk-wrap .qb6{background:linear-gradient(100deg,#6B1030,#A81850)}.tk-wrap .qb7{background:linear-gradient(100deg,#5A3A0A,#8A6015)}.tk-wrap .qb8{background:linear-gradient(100deg,#0D4A38,#14785A)}.tk-wrap .lead{padding:20px 32px 4px;font-size:16px;color:#cfc9be;line-height:1.75;max-width:760px}.tk-wrap .lead b{color:#f0ece4;font-weight:700}.tk-wrap h3.sec{padding:30px 32px 10px;font-size:18px;font-weight:700;color:#f0ece4;letter-spacing:-.2px}.tk-wrap h4.sub2{padding:22px 32px 8px;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#a8a29a}.tk-wrap .ans{margin:16px 32px;border-radius:11px;overflow:hidden;background:#1a1815;border:1px solid #2e2b27}.tk-wrap .ans-q{padding:14px 20px;background:#221f1b;border-bottom:1px solid #2e2b27;font-size:16px;font-weight:700;color:#f4f0e6}.tk-wrap .ans-q .qm{color:#6ECF80;margin-right:8px;font-weight:800}.tk-wrap .ans-a{padding:16px 20px;font-size:15.5px;color:#d4cec4;line-height:1.75}.tk-wrap .ans-a b{color:#f4f0e6}.tk-wrap .ans-a .short{display:block;font-size:17px;font-weight:700;color:#7FD8C4;margin-bottom:9px;line-height:1.5}.tk-wrap .twrap{padding:8px 32px 14px;overflow-x:auto}.tk-wrap table{width:100%;border-collapse:collapse;font-size:14px;min-width:420px;border-radius:8px;overflow:hidden}.tk-wrap thead th{background:#242119;color:#c8c2b6;font-size:11.5px;font-weight:700;text-transform:uppercase;
  letter-spacing:.08em;padding:12px 11px;text-align:left;border-bottom:2px solid #3a3630;white-space:nowrap}.tk-wrap tbody td{padding:12px 11px;border-bottom:1px solid #201e1c;vertical-align:top;color:#d4cec4;line-height:1.6}.tk-wrap tbody tr:hover{background:#1a1815}.tk-wrap tbody td.k{font-weight:700;color:#f4f0e6}.tk-wrap tbody td.num{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:600}.tk-wrap tbody td.dim{color:#aaa49a;font-size:13.5px}.tk-wrap tbody td.yes{color:#7EDD90;font-weight:600}.tk-wrap tbody td.no{color:#F08878;font-weight:600}.tk-wrap tbody td.say{color:#9fd09f;font-style:italic;font-size:13.5px}.tk-wrap .grp-row td{background:#1e1b18;color:#d0cabf;font-size:12px;font-weight:700;text-transform:uppercase;
  letter-spacing:.11em;padding:10px 11px}.tk-wrap .b1{border-left:3px solid #3E7CB1}.tk-wrap .b2{border-left:3px solid #4A9E5C}.tk-wrap .b3{border-left:3px solid #C9A227}.tk-wrap .b4{border-left:3px solid #D2691E}.tk-wrap .b5{border-left:3px solid #C0392B}.tk-wrap .myth{margin:14px 32px;display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:10px;overflow:hidden;border:1px solid #2e2b27}.tk-wrap .myth-l{background:#1e1310;padding:15px 18px;border-right:1px solid #2e2b27}.tk-wrap .myth-r{background:#131b14;padding:15px 18px}.tk-wrap .myth h5{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.11em;margin-bottom:7px}.tk-wrap .myth-l h5{color:#F08878}.tk-wrap .myth-r h5{color:#7EDD90}.tk-wrap .myth p{font-size:14.5px;line-height:1.7;color:#cfc9be}@media(max-width:620px){.tk-wrap .myth{grid-template-columns:1fr}.tk-wrap .myth-l{border-right:none;border-bottom:1px solid #2e2b27}}.tk-wrap .tip{margin:14px 32px;padding:16px 20px;border-radius:9px;background:#151714;border:1px solid #2a2f28;
  border-left:4px solid #4A9E5C;font-size:14.5px;color:#c4beb4;line-height:1.75}.tk-wrap .tip.warn{background:#1a1512;border-color:#3a2a24;border-left-color:#D2691E}.tk-wrap .tip.big{background:#141a1d;border-color:#26333a;border-left-color:#3E7CB1}.tk-wrap .tip b{color:#f0ece4}.tk-wrap .tip .t{display:block;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.11em;color:#8fbf8f;margin-bottom:7px}.tk-wrap .tip.warn .t{color:#E0A068}.tk-wrap .tip.big .t{color:#7FB8E0}.tk-wrap .calc{margin:18px 32px;background:#1a1815;border:1px solid #322e29;border-radius:11px;overflow:hidden}.tk-wrap .calc-head{background:#232019;padding:14px 20px;border-bottom:1px solid #322e29;font-size:15px;font-weight:700;color:#f4f0e6}.tk-wrap .calc-body{padding:18px 20px}.tk-wrap .crow{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px}.tk-wrap .cf{flex:1;min-width:130px}.tk-wrap .cf label{display:block;font-size:12px;font-weight:700;color:#b4aea4;margin-bottom:6px}.tk-wrap .cf input,.tk-wrap .cf select{width:100%;background:#100f0e;border:1px solid #363230;border-radius:7px;color:#f4f0e6;
  padding:11px 12px;font-size:15.5px;font-family:inherit;outline:none}.tk-wrap .cf input:focus,.tk-wrap .cf select:focus{border-color:#5aa87a}.tk-wrap .cf input::placeholder{color:#6d675f}.tk-wrap .cout{background:#100f0e;border:1px solid #2c2926;border-radius:9px;padding:17px 19px;min-height:60px}.tk-wrap .cout .ph{color:#8f8a82;font-size:14px;font-style:italic}.tk-wrap .cres{display:flex;flex-wrap:wrap;gap:18px 30px}.tk-wrap .cres .i{min-width:104px}.tk-wrap .cres .l{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#a8a29a;margin-bottom:4px}.tk-wrap .cres .v{font-size:25px;font-weight:800;color:#7FD8C4;font-variant-numeric:tabular-nums;line-height:1.1}.tk-wrap .cres .v.sm{font-size:17px}.tk-wrap .cres .s{font-size:12.5px;color:#a19b92;margin-top:3px}.tk-wrap .cnote{margin-top:14px;padding-top:12px;border-top:1px solid #2a2724;font-size:13.5px;color:#b0aaa1;line-height:1.7}.tk-wrap .cerr{color:#F08878;font-size:14px}.tk-wrap .footer{padding:42px 32px 0;font-size:13px;color:#a19b92;line-height:1.9;border-top:1px solid #2a2724;margin-top:54px}.tk-wrap .footer b{color:#d0cabf}
.tk-wrap .nav{position:static}
.tk-backbar{max-width:1180px;margin:0 auto;padding:92px 36px 0;background:#111110}
.tk-back{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:#a8a29a;text-decoration:none}
.tk-back:hover{color:#e0dbd3}
</style>

<script is:inline>
function $(i){return document.getElementById(i);}
function n(i){var e=$(i); if(!e) return NaN; var v=parseFloat(e.value); return isNaN(v)?NaN:v;}
function v(i){var e=$(i); return e?e.value:'';}
function f(x,d){ return isFinite(x)? x.toFixed(d===undefined?0:d) : '—'; }
function show(id,items,note){
  var h='<div class="cres">';
  for(var i=0;i<items.length;i++){
    h+='<div class="i"><div class="l">'+items[i][0]+'</div><div class="v'+(items[i][3]?' sm':'')+'">'+items[i][1]+'</div>';
    if(items[i][2]) h+='<div class="s">'+items[i][2]+'</div>';
    h+='</div>';
  }
  h+='</div>'; if(note) h+='<div class="cnote">'+note+'</div>';
  $(id).innerHTML=h;
}
function wait(id){ var e=$(id); if(e) e.innerHTML='<div class="ph">Fill in the boxes above and the answer appears here.</div>'; }
function bad(id,m){ $(id).innerHTML='<div class="cerr">'+m+'</div>'; }

/* ---- How hard am I working? (heart rate zones) ---- */
function calcHR(){
  var age=n('hr_age'), rest=n('hr_rest');
  if(isNaN(age)||age<10||age>100){ wait('hr_out'); return; }
  var max=Math.round(208-0.7*age);
  var r=isNaN(rest)?null:rest;
  function z(lo,hi){
    if(r===null) return Math.round(max*lo)+'–'+Math.round(max*hi);
    return Math.round((max-r)*lo+r)+'–'+Math.round((max-r)*hi+r);
  }
  var note = r===null
    ? 'These are percentages of your maximum heart rate. <b>Add your resting heart rate above for a more personal set of numbers.</b> To find it: sit still for five minutes, then count your pulse for 60 seconds. Best done first thing in the morning.'
    : 'These use your own resting heart rate, so they are properly personalised. <b>Most of your easy cardio should sit in the "Easy" band</b> — it feels almost too gentle, and that is the point.';
  show('hr_out',
    [['Your max heart rate', max, 'beats per minute'],
     ['Very easy', z(0.50,0.60)+'', 'warm-up, cool-down', true],
     ['Easy', z(0.60,0.70)+'', 'can hold a conversation', true],
     ['Moderate', z(0.70,0.80)+'', 'short sentences only', true],
     ['Hard', z(0.80,0.90)+'', 'a few words at a time', true],
     ['All out', z(0.90,1.00)+'', 'cannot talk', true]],
    note);
}

/* ---- How many calories did I burn? ---- */
var METS={walk_slow:2.8,walk:3.8,walk_brisk:4.8,walk_fast:5.5,jog:7.5,run:9.3,run_fast:11.8,
  cycle_easy:4.0,cycle:7.0,cycle_hard:10.0,swim:8.3,weights_light:3.5,weights:5.0,weights_hard:6.0,
  circuit:6.0,hiit:7.0,yoga:2.3,yoga_power:4.0,dance:6.5,stairs:6.8,skipping:11.0,
  cricket:4.8,badminton:5.5,football:7.0,housework:3.3,cooking:3.5,shopping:3.3};
function calcBurn(){
  var w=n('bn_wt'), mins=n('bn_min'), act=v('bn_act');
  if(isNaN(w)||isNaN(mins)||w<=0||mins<=0){ wait('bn_out'); return; }
  var met=METS[act];
  var gross=met*3.5*w/200*mins;
  var net=(met-1)*3.5*w/200*mins;
  show('bn_out',
    [['Calories burned', f(gross), 'total for '+f(mins)+' minutes'],
     ['Extra vs resting', f(net), 'above what you would burn sitting', true],
     ['Per hour', f(met*3.5*w/200*60), 'at this pace', true]],
    'The <b>"extra"</b> number is the honest one — you would have burned some calories anyway just existing. '
    +'<b>Do not eat these calories back.</b> Almost everyone overestimates burn and underestimates food, and that is the single most common reason progress stalls.');
}

/* ---- Steps ---- */
function calcSteps(){
  var w=n('st_wt'), s=n('st_steps');
  if(isNaN(w)||isNaN(s)||w<=0||s<=0){ wait('st_out'); return; }
  var km=s*0.00075;             /* ~0.75 m average stride */
  var kcal=km*w*0.5;            /* ~0.5 kcal per kg per km walked */
  show('st_out',
    [['Distance', f(km,1)+' km', 'roughly'],
     ['Calories', f(kcal), 'from walking', true],
     ['Time', f(s/110)+' min', 'at a normal pace', true]],
    'A rough guide — stride length varies. <b>The number that matters is whether today beat your average, not whether you hit 10,000.</b> '
    +'The 10,000 figure came from a 1960s Japanese pedometer advertisement, not from research. Real benefits start climbing from about 4,000 steps and keep improving to around 8,000–10,000.');
}

/* ---- Is this weight right? ---- */
function calcLoad(){
  var reps=n('ld_reps'), goal=v('ld_goal');
  if(isNaN(reps)||reps<1){ wait('ld_out'); return; }
  var target = goal==='str' ? [4,6] : goal==='size' ? [8,12] : [12,20];
  var msg, col;
  if(reps < target[0]-1){ msg='<b>Too heavy.</b> Drop the weight by about 10% next set.'; }
  else if(reps > target[1]+2){ msg='<b>Too light.</b> Add about 5–10% next session.'; }
  else if(reps > target[1]){ msg='<b>Slightly light</b> — you have earned an increase next session.'; }
  else { msg='<b>This is the right weight.</b> Stay here until the top of the range feels easy.'; }
  show('ld_out',
    [['Your target range', target[0]+'–'+target[1]+' reps', 'for this goal'],
     ['You managed', f(reps)+' reps', '', true]],
    msg+'<br><br><b>The rule that matters:</b> when you can do the top of your rep range with good form and about two reps still in the tank, add a small amount of weight and start again at the bottom of the range. That is progress. Nothing else is required.');
}

document.addEventListener('DOMContentLoaded',function(){
  ['hr_out','bn_out','st_out','ld_out'].forEach(wait);
});
</script>

</Layout>
