<script is:inline>
(function(){
  // energy-density blocks
  var veg = document.getElementById('vegBlocks');
  var fry = document.getElementById('fryBlocks');
  if(veg && fry){
    for(var i=0;i<28;i++){ var d=document.createElement('span'); d.className='blk veg'; veg.appendChild(d); }
    for(var j=0;j<4;j++){ var f=document.createElement('span'); f.className='blk fry'; fry.appendChild(f); }
  }

  // scroll reveal
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var items = document.querySelectorAll('.ho-wrap .rv');
  if(reduce || !('IntersectionObserver' in window)){
    items.forEach(function(el){ el.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:0.08, rootMargin:'0px 0px -40px 0px'});
  items.forEach(function(el){ io.observe(el); });
})();
</script>

