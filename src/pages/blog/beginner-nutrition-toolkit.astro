<script is:inline>
function $(i){return document.getElementById(i);}
function n(i){var e=$(i); if(!e) return NaN; var v=parseFloat(e.value); return isNaN(v)?NaN:v;}
function v(i){var e=$(i); return e?e.value:'';}
function f(x,d){ return isFinite(x)? x.toFixed(d===undefined?0:d) : '—'; }
function show(id,items,note){
  var h='<div class="cres">';
  for(var i=0;i<items.length;i++){
    h+='<div class="i"><div class="l">'+items[i][0]+'</div><div class="v'+(items[i][3]?' sm':'')+'">'+items[i][1]+'</div>';
    if(items[i][2]) h+='<div class="s">'+items[i][2]+'</div>';
    h+='</div>';
  }
  h+='</div>'; if(note) h+='<div class="cnote">'+note+'</div>';
  $(id).innerHTML=h;
}
function wait(id){ var e=$(id); if(e) e.innerHTML='<div class="ph">Fill in the boxes above and the answer appears here.</div>'; }

/* ══ CALORIE + PROTEIN TARGET ══ */
function calcCal(){
  var sex=v('cc_sex'), age=n('cc_age'), ht=n('cc_ht'), wt=n('cc_wt'),
      pal=parseFloat(v('cc_act')), goal=v('cc_goal');
  if(isNaN(age)||isNaN(ht)||isNaN(wt)||age<12||ht<100||wt<25){ wait('cc_out'); return; }
  /* Mifflin-St Jeor, then the ICMR-NIN 10% downward correction for Indian body composition */
  var bmr = 10*wt + 6.25*ht - 5*age + (sex==='m'?5:-161);
  var bmrAdj = bmr*0.90;
  var maint = bmrAdj*pal;
  var target, rate, note;
  if(goal==='lose'){        target=maint-500; rate='about 0.4–0.5 kg per week'; }
  else if(goal==='lose_s'){ target=maint-300; rate='about 0.25–0.3 kg per week'; }
  else if(goal==='gain'){   target=maint+300; rate='about 0.25–0.4 kg per month of muscle, if you train'; }
  else {                    target=maint;     rate='holding steady'; }
  if(target < (sex==='m'?1500:1200)){
    target = (sex==='m'?1500:1200);
    note='<b>Note:</b> your deficit target came out very low, so it has been raised to a safer floor. Eating too little backfires — you lose muscle, feel awful and rebound.<br><br>';
  } else note='';

  var pLo=Math.round(wt*1.6), pHi=Math.round(wt*2.2);
  var fatG=Math.round(target*0.25/9);
  var carbG=Math.round((target - pLo*4 - fatG*9)/4);

  show('cc_out',
   [['Eat this many calories', f(target), 'per day'],
    ['Protein', pLo+'–'+pHi+' g', 'per day', true],
    ['Fat', '~'+fatG+' g', 'about 25% of calories', true],
    ['Carbs', '~'+carbG+' g', 'whatever is left', true],
    ['Just maintaining', f(maint), 'if you changed nothing', true]],
   note+'Expect <b>'+rate+'</b>.<br><br>'
   +'<b>Treat this as a starting point, not a fact.</b> Every formula has a margin of error of roughly ±10%, which is a couple of hundred calories here. '
   +'Eat at this number for two weeks, weigh yourself daily and compare the weekly averages. If nothing moved, drop by 150. If it moved too fast, add 150. '
   +'Your bathroom scale over a fortnight is more accurate than any equation.<br><br>'
   +'<b>Get the protein right first.</b> If you only manage one thing from this whole page, make it the protein number — it protects your muscle while you lose fat, and it keeps you full.');
}

/* ══ WHAT IS MY MEAL WORTH? ══ */
/* [label, kcal, protein g] per one household serving */
var FOODS = {
 'roti':        ['Roti / chapati (1)',            100, 3.6],
 'phulka':      ['Phulka, thin (1)',               85, 3.0],
 'paratha':     ['Paratha, plain (1)',            181, 4.8],
 'aloo_par':    ['Aloo paratha (1)',              290, 6.5],
 'puri':        ['Puri (1)',                      105, 2.2],
 'naan':        ['Naan (1)',                      240, 7.0],
 'bread':       ['Bread slice (1)',                80, 2.5],
 'rice':        ['Rice, cooked (1 katori)',       200, 4.0],
 'rice_cup':    ['Rice, cooked (1 cup)',          265, 5.3],
 'biryani_v':   ['Veg biryani (1 plate)',         400, 9.0],
 'biryani_c':   ['Chicken biryani (1 plate)',     550, 25.0],
 'poha':        ['Poha (1 plate)',                250, 4.0],
 'upma':        ['Upma (1 katori)',               230, 5.0],
 'idli':        ['Idli (1)',                       58, 1.9],
 'dosa':        ['Dosa, plain (1)',               145, 3.5],
 'dosa_m':      ['Masala dosa (1)',               290, 6.0],
 'oats':        ['Oats in water (1 katori)',      115, 4.0],
 'dal':         ['Dal (1 katori)',                145, 8.0],
 'dal_makhani': ['Dal makhani (1 katori)',        280, 8.0],
 'rajma':       ['Rajma (1 katori)',              180, 8.0],
 'chole':       ['Chole (1 katori)',              200, 8.0],
 'sambar':      ['Sambar (1 katori)',             105, 4.5],
 'sprouts':     ['Sprouts (1 katori)',             95, 7.5],
 'soya':        ['Soya chunks, dry (30 g)',       100, 15.6],
 'milk_t':      ['Milk, toned (1 glass)',         118, 6.4],
 'milk_f':      ['Milk, full cream (1 glass)',    150, 6.6],
 'curd':        ['Curd (1 katori)',                90, 5.3],
 'greek':       ['Greek yogurt (100 g)',           60, 10.0],
 'paneer':      ['Paneer (2 cubes, 50 g)',        132, 9.2],
 'tofu':        ['Tofu (100 g)',                   76, 8.0],
 'egg':         ['Egg, whole (1)',                 78, 6.5],
 'eggwhite':    ['Egg white (1)',                  17, 3.6],
 'chicken':     ['Chicken breast (1 palm)',       165, 31.0],
 'chicken_c':   ['Chicken curry (1 katori)',      250, 20.0],
 'fish':        ['Fish curry (1 katori)',         190, 18.0],
 'mutton':      ['Mutton curry (1 katori)',       310, 18.0],
 'whey':        ['Whey protein (1 scoop)',        120, 24.0],
 'sabzi_dry':   ['Dry sabzi (1 katori)',           90, 2.5],
 'sabzi_gravy': ['Gravy sabzi (1 katori)',        175, 3.0],
 'aloo_sabzi':  ['Aloo sabzi (1 katori)',         165, 3.0],
 'palak_p':     ['Palak paneer (1 katori)',       220, 11.0],
 'salad':       ['Salad, no dressing (1 katori)',  25, 1.0],
 'ghee':        ['Ghee (1 tsp)',                   45, 0],
 'oil':         ['Oil (1 tbsp)',                  135, 0],
 'peanuts':     ['Peanuts (1 handful)',           170, 7.6],
 'almonds':     ['Almonds (10)',                   70, 2.5],
 'pb':          ['Peanut butter (1 tbsp)',         95, 4.0],
 'samosa':      ['Samosa (1)',                    200, 3.5],
 'pakora':      ['Pakora (4)',                    180, 4.0],
 'vadapav':     ['Vada pav (1)',                  300, 7.0],
 'biscuit':     ['Biscuits (4)',                  110, 1.7],
 'namkeen':     ['Namkeen (1 small bowl)',        160, 3.5],
 'gulab':       ['Gulab jamun (1)',               150, 2.0],
 'jalebi':      ['Jalebi (1)',                    110, 0.5],
 'rasgulla':    ['Rasgulla (1)',                  106, 2.0],
 'ladoo':       ['Besan ladoo (1)',               185, 3.5],
 'chai':        ['Chai with sugar (1 cup)',        90, 2.2],
 'coffee_m':    ['Milk coffee with sugar (1 cup)', 90, 2.2],
 'cold_drink':  ['Cold drink (300 ml)',           130, 0],
 'juice':       ['Packaged juice (200 ml)',       110, 0.5],
 'beer':        ['Beer (330 ml)',                 145, 1.5],
 'whisky':      ['Whisky / spirits (30 ml peg)',   65, 0],
 'wine':        ['Wine (150 ml)',                 125, 0],
 'banana':      ['Banana (1)',                     90, 1.2],
 'apple':       ['Apple (1)',                      78, 0.4],
 'mango':       ['Mango (1)',                     120, 1.2],
 'papaya':      ['Papaya (1 katori)',              65, 0.8],
 'orange':      ['Orange (1)',                     61, 1.2]
};
var MEAL=[];
function mealInit(){
  var s=$('ml_food'); if(!s) return;
  var keys=Object.keys(FOODS);
  keys.sort(function(a,b){ return FOODS[a][0].localeCompare(FOODS[b][0]); });
  var h='';
  for(var i=0;i<keys.length;i++) h+='<option value="'+keys[i]+'">'+FOODS[keys[i]][0]+'</option>';
  s.innerHTML=h;
  renderMeal();
}
function mealAdd(){
  var k=v('ml_food'), q=n('ml_qty');
  if(!k||isNaN(q)||q<=0) q=1;
  MEAL.push([k,q]); renderMeal();
}
function mealClear(){ MEAL=[]; renderMeal(); }
function mealDel(i){ MEAL.splice(i,1); renderMeal(); }
function renderMeal(){
  var out=$('ml_out'); if(!out) return;
  if(MEAL.length===0){
    out.innerHTML='<div class="ph">Pick a food, set how many, and press Add. Build up your whole meal or your whole day.</div>';
    return;
  }
  var kc=0,pr=0,list='<div class="mlist">';
  for(var i=0;i<MEAL.length;i++){
    var k=MEAL[i][0], q=MEAL[i][1], d=FOODS[k];
    kc+=d[1]*q; pr+=d[2]*q;
    list+='<div class="mrow"><span class="mq">'+(q%1===0?q:q.toFixed(1))+'&times;</span>'
        + '<span class="mn">'+d[0]+'</span>'
        + '<span class="mk">'+Math.round(d[1]*q)+' kcal</span>'
        + '<span class="mp">'+(d[2]*q).toFixed(1)+' g P</span>'
        + '<button class="mx" onclick="mealDel('+i+')" title="Remove">&times;</button></div>';
  }
  list+='</div>';
  var pctP = kc>0 ? (pr*4/kc*100) : 0;
  var verdict;
  if(pctP<10) verdict='<b>Very low in protein.</b> This is the single most common problem with Indian meals. Add curd, paneer, egg, sprouts, soya or dal.';
  else if(pctP<18) verdict='<b>A bit low in protein.</b> One more protein item would balance this well.';
  else if(pctP<32) verdict='<b>Well balanced.</b> Good protein for the calories.';
  else verdict='<b>Very high in protein.</b> Fine — but make sure you are getting enough carbs to train on.';
  out.innerHTML = list
   + '<div class="cres" style="margin-top:14px">'
   + '<div class="i"><div class="l">Total calories</div><div class="v">'+Math.round(kc)+'</div></div>'
   + '<div class="i"><div class="l">Total protein</div><div class="v">'+pr.toFixed(1)+' g</div></div>'
   + '<div class="i"><div class="l">Protein share</div><div class="v sm">'+pctP.toFixed(0)+'%</div><div class="s">of calories</div></div>'
   + '</div><div class="cnote">'+verdict+'</div>';
}

document.addEventListener('DOMContentLoaded',function(){
  wait('cc_out'); mealInit();
});
</script>

</Layout>
