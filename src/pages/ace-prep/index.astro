---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allChapters = await getCollection('ace');
const sortedChapters = allChapters.sort((a, b) => a.data.chapter - b.data.chapter);
---

<Layout title="ACE Chapterwise Preparation | Lifelong Athletics" description="Master the ACE Personal Trainer exam chapter by chapter with interactive theory, mindmaps, and quizzes.">
  <div class="header-section">
    <p class="section-eyebrow">Exam Prep Hub</p>
    <h1>ACE Chapterwise <em>Preparation.</em></h1>
    <p class="hero-sub">17 Chapters. Theory, notes, and interactive quizzes for every single topic to guarantee you pass the ACE Personal Trainer Certification.</p>
  </div>

  <section class="chapters-section">
    <div class="chapters-grid">
      {sortedChapters.map((ch) => (
        <a href={`/ace-prep/${ch.id}`} class="chapter-card">
          <div class="chapter-num">Chapter {ch.data.chapter}</div>
          <h2 class="chapter-title">{ch.data.title}</h2>
          <p class="chapter-desc">{ch.data.description}</p>
          <div class="card-footer">
            <span class="view-link">Study Smart →</span>
          </div>
        </a>
      ))}
    </div>

    <a href="/exam-prep/cpt-practice-exam" class="exam-capstone">
      <div class="ec-left">
        <span class="ec-tag">✦ After the 17 chapters</span>
        <h2 class="ec-title">Full <em>CPT Practice Exam</em></h2>
        <p class="ec-sub">100 questions · a 90-minute timer · every domain · flag &amp; review · a per-domain score breakdown. The closest thing to sitting the real exam.</p>
      </div>
      <span class="ec-cta">Start the Mock Exam <span class="ec-arrow">→</span></span>
    </a>
  </section>
</Layout>

<style>
  .header-section {
    padding: 160px 60px 80px;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .section-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  h1 em {
    font-style: italic;
    color: var(--gold);
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--muted);
    line-height: 1.8;
    max-width: 600px;
    margin: 0 auto;
  }

  .chapters-section {
    padding: 40px 60px 120px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .chapters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .chapter-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 32px;
    text-decoration: none;
    color: var(--white);
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .chapter-card:hover {
    transform: translateY(-4px);
    border-color: rgba(201,168,76,0.4);
    background: var(--surface2);
  }
  .chapter-num {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .chapter-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.2;
  }
  .chapter-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 24px;
    flex-grow: 1;
  }
  .card-footer {
    border-top: 1px solid var(--border);
    padding-top: 16px;
    display: flex;
    justify-content: flex-end;
  }
  @keyframes text-breathe {
    0%,100% { color: rgba(197,241,53,0.65); text-shadow: none; }
    50%      { color: #c5f135; text-shadow: 0 0 14px rgba(197,241,53,0.55); }
  }
  .view-link {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c5f135;
    animation: text-breathe 3s ease-in-out infinite;
  }
  .chapter-card:hover .view-link {
    animation-play-state: paused;
    color: #c5f135;
    text-shadow: 0 0 18px rgba(197,241,53,0.7);
  }

  /* CAPSTONE — full practice exam bar (set apart from the gold chapter cards) */
  .exam-capstone {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 44px;
    padding: 36px 44px;
    text-decoration: none;
    background: linear-gradient(135deg, rgba(197,241,53,0.08), rgba(197,241,53,0.015) 60%);
    border: 1px solid rgba(197,241,53,0.3);
    border-radius: 10px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .exam-capstone:hover {
    transform: translateY(-3px);
    border-color: #c5f135;
    box-shadow: 0 14px 44px rgba(197,241,53,0.14);
  }
  .ec-tag {
    display: inline-flex;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c5f135;
    background: rgba(197,241,53,0.1);
    padding: 6px 13px;
    border-radius: 20px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .ec-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 400;
    color: var(--white);
    line-height: 1.05;
    margin-bottom: 10px;
  }
  .ec-title em { font-style: italic; color: #c5f135; }
  .ec-sub {
    font-size: 0.92rem;
    color: rgba(245,240,232,0.6);
    line-height: 1.6;
    max-width: 640px;
  }
  .ec-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #c5f135;
    color: #080808;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 15px 30px;
    border-radius: 30px;
    transition: gap 0.25s, box-shadow 0.3s;
  }
  .exam-capstone:hover .ec-cta { gap: 16px; box-shadow: 0 8px 24px rgba(197,241,53,0.32); }

  @media (max-width: 768px) {
    .header-section { padding: 120px 24px 60px; }
    .chapters-section { padding: 0 24px 80px; }
    .chapters-grid { grid-template-columns: 1fr; }
    .exam-capstone { flex-direction: column; align-items: flex-start; padding: 28px 24px; gap: 20px; }
    .ec-cta { width: 100%; justify-content: center; }
  }
</style>
